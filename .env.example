# ============================================
# PraiseBot Environment Configuration
# ============================================
# Copy this file to .env for local testing.
# On Railway, set these in the Variables tab.
# NEVER commit a real .env file to GitHub.

# --- REQUIRED ---
# Your Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# --- MODEL ---
# Path where the GGUF model file is stored (persistent volume)
MODEL_PATH=/data/models/qwen2.5-3b-instruct-q4_k_m.gguf

# Direct download URL for the model file (used only if file is missing)
MODEL_URL=https://huggingface.co/bartowski/Qwen2.5-3B-Instruct-GGUF/resolve/main/Qwen2.5-3B-Instruct-Q4_K_M.gguf

# --- INFERENCE TUNING ---
# Context window size (tokens). Lower = less RAM.
N_CTX=2048

# CPU threads for inference. Match Railway vCPU allocation.
N_THREADS=4

# Maximum tokens to generate per response
MAX_TOKENS=512

# Sampling temperature (0.0 = deterministic, 1.0 = creative)
TEMPERATURE=0.7

# Top-p (nucleus) sampling threshold
TOP_P=0.9

# --- SAFETY & LIMITS ---
# Maximum characters accepted from a user message
MAX_INPUT_CHARS=2000

# Seconds a user must wait between requests
USER_COOLDOWN_SECONDS=10

# Number of conversation turns kept in memory per user
MAX_HISTORY_TURNS=5

# Model download timeout in seconds
DOWNLOAD_TIMEOUT=600

# --- LOGGING ---
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
